#!/usr/bin/env python3
"""gale-console — interactive console for the Google WiFi (Gale, AC-1304)
debug interface over a SuzyQ / SuzyQable adapter.

Bidirectional: reads device output to stdout, sends keystrokes from stdin
to the device's bulk OUT endpoint.

CAVEAT: On a stock / locked Gale, the OUT (write) endpoint times out — CCD
is read-only until unlocked. If you see "[write fail]" errors, the device's
CCD is locked and you can only sniff (use `gale-sniff` instead).

Exit: Ctrl-C.
"""
import argparse
import os
import select
import sys
import termios
import threading
import tty
import usb.core
import usb.util

VID = 0x18D1
PID = 0x500F


def reader(ep_in, stop):
    while not stop.is_set():
        try:
            data = ep_in.read(ep_in.wMaxPacketSize, timeout=300)
            if data:
                os.write(1, bytes(data))
        except usb.core.USBError as e:
            msg = str(e).lower()
            if "timeout" in msg or getattr(e, "errno", None) == 60:
                continue
            sys.stderr.write(f"\r\n[read error: {e}]\r\n")
            stop.set()
            return


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--iface", type=int, default=1,
                   help="USB interface (0=EC_PD, 1=AP, default 1)")
    args = p.parse_args()

    dev = usb.core.find(idVendor=VID, idProduct=PID)
    if dev is None:
        sys.exit("Gale debug device not found")

    cfg = dev.get_active_configuration()
    intf = cfg[(args.iface, 0)]
    label = "?"
    if intf.iInterface:
        try:
            label = usb.util.get_string(dev, intf.iInterface)
        except Exception:
            pass
    sys.stderr.write(
        f"[gale-console] iface {args.iface} ({label}). Ctrl-C to exit.\r\n"
    )

    try:
        if dev.is_kernel_driver_active(args.iface):
            dev.detach_kernel_driver(args.iface)
    except (NotImplementedError, usb.core.USBError):
        pass
    usb.util.claim_interface(dev, args.iface)

    ep_in = next(ep for ep in intf
                 if usb.util.endpoint_direction(ep.bEndpointAddress) == usb.util.ENDPOINT_IN)
    ep_out = next(ep for ep in intf
                  if usb.util.endpoint_direction(ep.bEndpointAddress) == usb.util.ENDPOINT_OUT)

    stop = threading.Event()
    threading.Thread(target=reader, args=(ep_in, stop), daemon=True).start()

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        while not stop.is_set():
            r, _, _ = select.select([fd], [], [], 0.1)
            if r:
                b = os.read(fd, 1)
                if b == b"\x03":  # Ctrl-C
                    break
                try:
                    ep_out.write(b, timeout=500)
                except usb.core.USBError as e:
                    sys.stderr.write(f"\r\n[write fail: {e} — CCD likely locked]\r\n")
                    break
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        stop.set()
        usb.util.release_interface(dev, args.iface)
        sys.stderr.write("\r\n[gale-console] disconnected\r\n")


if __name__ == "__main__":
    main()
