#!/usr/bin/env python3
"""gale-sniff-all — capture every Gale debug interface in parallel,
with reconnect support across power cycles.

Each line of output is prefixed with the interface label
([EC_PD], [AP], [iface3]) so you can see who said what during boot.

Designed for catching the boot trace:
  1. Run with --wait so it polls for the device to appear.
  2. Unplug the SuzyQ from the Mac to power off the puck.
  3. Replug to power on. The script starts reading from t=0.
  4. Power-cycle again any time; the script reconnects automatically.

Usage:
    gale-sniff-all                 # all ifaces, forever
    gale-sniff-all --duration 60   # 60 s wall-clock then exit
    gale-sniff-all --wait          # wait for device if absent
"""
import argparse
import sys
import threading
import time
import usb.core
import usb.util

VID = 0x18D1
PID = 0x500F


def label(dev, intf):
    if intf.iInterface:
        try:
            return usb.util.get_string(dev, intf.iInterface) or f"iface{intf.bInterfaceNumber}"
        except Exception:
            pass
    return f"iface{intf.bInterfaceNumber}"


def reader(name, ep_in, stop, totals, lock):
    buf = bytearray()
    while not stop.is_set():
        try:
            chunk = ep_in.read(ep_in.wMaxPacketSize, timeout=400)
        except usb.core.USBError as e:
            msg = str(e).lower()
            errno = getattr(e, "errno", None)
            if "timeout" in msg or errno == 60:
                continue
            if errno in (5, 19) or "no such device" in msg or "i/o" in msg:
                return  # device gone — main loop will reconnect
            with lock:
                sys.stderr.write(f"[{name}] read error: {e}\n")
            return
        if not chunk:
            continue
        buf.extend(chunk)
        while b"\n" in buf:
            line, _, rest = buf.partition(b"\n")
            with lock:
                ts = time.strftime("%H:%M:%S")
                sys.stdout.write(f"{ts} [{name}] {line.decode('utf-8', 'replace')}\n")
                sys.stdout.flush()
            buf = bytearray(rest)
        with lock:
            totals[name] = totals.get(name, 0) + len(chunk)


def wait_for_device(quiet=False):
    while True:
        dev = usb.core.find(idVendor=VID, idProduct=PID)
        if dev is not None:
            return dev
        if not quiet:
            sys.stderr.write("[gale-sniff-all] waiting for device... (plug SuzyQ in)\n")
            quiet = True
        time.sleep(0.1)


def attach_and_read(dev, stop, totals, lock):
    """Claim interfaces, spawn reader threads, return them."""
    threads = []
    claimed = []
    try:
        cfg = dev.get_active_configuration()
    except usb.core.USBError as e:
        sys.stderr.write(f"[gale-sniff-all] cfg fetch failed: {e}\n")
        return threads, claimed
    for intf in cfg:
        n = intf.bInterfaceNumber
        name = label(dev, intf)
        try:
            if dev.is_kernel_driver_active(n):
                dev.detach_kernel_driver(n)
        except (NotImplementedError, usb.core.USBError):
            pass
        try:
            usb.util.claim_interface(dev, n)
            claimed.append(n)
        except usb.core.USBError as e:
            sys.stderr.write(f"[{name}] claim failed: {e}\n")
            continue
        ep_in = next(
            (ep for ep in intf
             if usb.util.endpoint_direction(ep.bEndpointAddress) == usb.util.ENDPOINT_IN),
            None,
        )
        if ep_in is None:
            sys.stderr.write(f"[{name}] no IN endpoint\n")
            continue
        t = threading.Thread(
            target=reader, args=(name, ep_in, stop, totals, lock), daemon=True,
        )
        t.start()
        threads.append(t)
    return threads, claimed


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--duration", type=float, default=0,
                   help="wall-clock seconds to capture (0=forever)")
    p.add_argument("--wait", action="store_true",
                   help="poll for device if absent at start")
    args = p.parse_args()

    totals = {}
    lock = threading.Lock()
    stop = threading.Event()

    dev = usb.core.find(idVendor=VID, idProduct=PID)
    if dev is None:
        if not args.wait:
            sys.exit("Gale debug device not found (try --wait)")
        dev = wait_for_device()

    start = time.time()
    end = (start + args.duration) if args.duration > 0 else float("inf")
    sys.stderr.write(
        f"[gale-sniff-all] running. duration="
        f"{args.duration if args.duration > 0 else 'forever'}s. "
        f"Ctrl-C to stop.\n"
    )
    try:
        while time.time() < end and not stop.is_set():
            threads, claimed = attach_and_read(dev, stop, totals, lock)
            while threads and any(t.is_alive() for t in threads):
                if time.time() >= end or stop.is_set():
                    break
                time.sleep(0.2)
            for n in claimed:
                try:
                    usb.util.release_interface(dev, n)
                except Exception:
                    pass
            if time.time() >= end or stop.is_set():
                break
            # device went away — wait for re-plug
            sys.stderr.write("\n[gale-sniff-all] device disconnected, waiting for re-plug...\n")
            dev = wait_for_device()
            sys.stderr.write("[gale-sniff-all] device reappeared, reading\n")
    except KeyboardInterrupt:
        pass
    finally:
        stop.set()

    sys.stderr.write("\n[gale-sniff-all] totals:\n")
    for name, n in sorted(totals.items()):
        sys.stderr.write(f"  {name}: {n} bytes\n")


if __name__ == "__main__":
    main()
