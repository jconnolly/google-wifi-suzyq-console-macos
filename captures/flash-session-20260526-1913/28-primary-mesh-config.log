-- wireless.mesh --
wireless.mesh=wifi-iface
wireless.mesh.device='radio1'
wireless.mesh.network='lan'
wireless.mesh.mode='mesh'
wireless.mesh.mesh_id='cinque-mesh'
wireless.mesh.encryption='sae'
wireless.mesh.key=<REDACTED>

